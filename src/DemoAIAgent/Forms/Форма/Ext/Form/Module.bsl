#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Инициализация значений по умолчанию согласно технической спецификации
	Если ПустаяСтрока(Объект.АдресAPI) Тогда
		Объект.АдресAPI = "http://localhost:11434/v1/chat/completions";
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.APIКлюч) Тогда
		Объект.APIКлюч = "ollama";
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.Модель) Тогда
		Объект.Модель = "qwen2.5-coder:7b";
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.ТекущийКаталог) Тогда
		Объект.ТекущийКаталог = КаталогВременныхФайлов();
	КонецЕсли;
	
	Если Объект.МаксимумИтераций = 0 Тогда
		Объект.МаксимумИтераций = 10;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьЗапрос(Команда)
	
	Если ПустаяСтрока(Объект.ЗапросПользователя) Тогда
		ПоказатьПредупреждение(, "Укажите запрос для автономного ИИ-агента!");
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗапросНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьЗапросНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ВыполнитьАгента();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

#КонецОбласти
