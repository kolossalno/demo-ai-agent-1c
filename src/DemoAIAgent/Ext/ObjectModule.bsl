#Область ПрограммныйИнтерфейс

// Главный цикл ReAct (Reasoning + Acting) автономного ИИ-агента
Процедура ВыполнитьАгента() Экспорт
	
	ЛогРассуждений = "";
	ФинальныйОтвет = "";
	
	// 1. Формирование системного промпта и начальной истории сообщений
	СистемныйПромпт = СтрШаблон(
		"Ты — автономный ИИ-агент, работающий внутри платформы 1С:Предприятие. Твой стартовый рабочий каталог: %1. "
		+ "Для исследования файловой системы и получения информации о среде используй доступные инструменты. "
		+ "Отвечай на русском языке четко и по делу после того, как соберешь все необходимые данные.",
		ТекущийКаталог
	);
	
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "system", СистемныйПромпт));
	Сообщения.Добавить(Новый Структура("role, content", "user", ЗапросПользователя));
	
	ПараметрыURL = РазобратьURL(АдресAPI);
	СхемыИнструментов = ПолучитьСхемыИнструментов();
	
	// 2. Главный цикл автономного взаимодействия с LLM
	Для Итерация = 1 По МаксимумИтераций Цикл
		
		ДобавитьВЛог(СтрШаблон("--- Итерация %1 ---", Формат(Итерация, "ЧГ=0")));
		
		// 2.1. Формирование тела запроса OpenAI-совместимого API
		ТелоЗапроса = Новый Структура;
		ТелоЗапроса.Вставить("model", Модель);
		ТелоЗапроса.Вставить("messages", Сообщения);
		ТелоЗапроса.Вставить("tools", СхемыИнструментов);
		ТелоЗапроса.Вставить("temperature", 0.1);
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
		СтрокаJSON = ЗаписьJSON.Закрыть();
		
		// 2.2. Выполнение HTTP-запроса к серверу LLM
		Попытка
			Соединение = Новый HTTPСоединение(
				ПараметрыURL.Сервер,
				ПараметрыURL.Порт,
				, , , 60,
				ПараметрыURL.ЗащищенноеСоединение
			);
			
			HTTPЗапрос = Новый HTTPЗапрос(ПараметрыURL.ПутьРесурса);
			HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			Если Не ПустаяСтрока(APIКлюч) Тогда
				HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + APIКлюч);
			КонецЕсли;
			HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			
			HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		Исключение
			ТекстОшибки = "Ошибка сетевого соединения с LLM: " + ОписаниеОшибки();
			ДобавитьВЛог("[ОШИБКА] " + ТекстОшибки);
			ФинальныйОтвет = ТекстОшибки;
			Возврат;
		КонецПопытки;
		
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			ТекстОшибки = СтрШаблон("Сервер LLM вернул код %1: %2", HTTPОтвет.КодСостояния, HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
			ДобавитьВЛог("[ОШИБКА] " + ТекстОшибки);
			ФинальныйОтвет = ТекстОшибки;
			Возврат;
		КонецЕсли;
		
		// 2.3. Разбор ответа LLM и добавление сообщения в историю
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		ОтветСтруктура = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
		
		СообщениеОтвета = ОтветСтруктура.choices[0].message;
		Сообщения.Добавить(СообщениеОтвета);
		
		// 2.4. Проверка необходимости вызова инструментов (tool_calls)
		ЕстьВызовы = СообщениеОтвета.Свойство("tool_calls")
			И СообщениеОтвета.tool_calls <> Неопределено
			И ТипЗнч(СообщениеОтвета.tool_calls) = Тип("Массив")
			И СообщениеОтвета.tool_calls.Количество() > 0;
		
		Если Не ЕстьВызовы Тогда
			// Ветка А: финальный ответ модели пользователю
			ДобавитьВЛог("[ФИНАЛ] Агент завершил работу.");
			Если СообщениеОтвета.Свойство("content") И СообщениеОтвета.content <> Неопределено Тогда
				ФинальныйОтвет = СокращатьТекст(Строка(СообщениеОтвета.content));
			КонецЕсли;
			Прервать;
		Иначе
			// Ветка Б: вызовы функций на стороне сервера 1С
			Для Каждого Вызов Из СообщениеОтвета.tool_calls Цикл
				IDВызова = Вызов.id;
				ИмяФункции = Вызов.function.name;
				АргументыСтрокой = Вызов.function.arguments;
				
				ДобавитьВЛог(СтрШаблон("[ВЫЗОВ] %1(%2)", ИмяФункции, АргументыСтрокой));
				РезультатИнструмента = ВыполнитьИнструмент(ИмяФункции, АргументыСтрокой);
				ДобавитьВЛог("[ОТВЕТ 1С] " + РезультатИнструмента);
				
				ОтветИнструмента = Новый Структура;
				ОтветИнструмента.Вставить("role", "tool");
				ОтветИнструмента.Вставить("tool_call_id", IDВызова);
				ОтветИнструмента.Вставить("content", РезультатИнструмента);
				Сообщения.Добавить(ОтветИнструмента);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	// 3. Контроль превышения лимита шагов
	Если ПустаяСтрока(ФинальныйОтвет) Тогда
		ФинальныйОтвет = "Достигнут лимит итераций. Агент не успел завершить задачу.";
		ДобавитьВЛог("[ЛИМИТ] " + ФинальныйОтвет);
	КонецЕсли;
	
КонецПроцедуры

// Диспетчер вызова инструментов
Функция ВыполнитьИнструмент(ИмяФункции, АргументыСтрокой) Экспорт
	
	Параметры = РазобратьJSONСтроку(АргументыСтрокой);
	
	Если ИмяФункции = "get_os_info" Тогда
		Возврат Инструмент_get_os_info();
		
	ИначеЕсли ИмяФункции = "list_files" Тогда
		Маска = "*.*";
		Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("mask") И Не ПустаяСтрока(Параметры.mask) Тогда
			Маска = Параметры.mask;
		КонецЕсли;
		Возврат Инструмент_list_files(Маска);
		
	ИначеЕсли ИмяФункции = "change_directory" Тогда
		ЦелевойПуть = "";
		Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("path") Тогда
			ЦелевойПуть = Параметры.path;
		КонецЕсли;
		Возврат Инструмент_change_directory(ЦелевойПуть);
		
	Иначе
		Возврат "Ошибка: неизвестный инструмент " + ИмяФункции;
	КонецЕсли;
	
КонецФункции

// Генерация массива описаний инструментов для OpenAI API
Функция ПолучитьСхемыИнструментов() Экспорт
	
	Схемы = Новый Массив;
	
	// 1. get_os_info
	ПараметрыOS = Новый Структура;
	ПараметрыOS.Вставить("type", "object");
	ПараметрыOS.Вставить("properties", Новый Структура);
	ПараметрыOS.Вставить("required", Новый Массив);
	
	ФункцияOS = Новый Структура;
	ФункцияOS.Вставить("name", "get_os_info");
	ФункцияOS.Вставить("description", "Определение операционной системы, типа платформы и версии 1С:Предприятия.");
	ФункцияOS.Вставить("parameters", ПараметрыOS);
	
	ИнструментOS = Новый Структура;
	ИнструментOS.Вставить("type", "function");
	ИнструментOS.Вставить("function", ФункцияOS);
	Схемы.Добавить(ИнструментOS);
	
	// 2. list_files
	СвойствоMask = Новый Структура;
	СвойствоMask.Вставить("type", "string");
	СвойствоMask.Вставить("description", "Маска поиска файлов, например '*.*' или '*.txt'. По умолчанию '*.*'.");
	
	СвойстваList = Новый Структура;
	СвойстваList.Вставить("mask", СвойствоMask);
	
	ПараметрыList = Новый Структура;
	ПараметрыList.Вставить("type", "object");
	ПараметрыList.Вставить("properties", СвойстваList);
	ПараметрыList.Вставить("required", Новый Массив);
	
	ФункцияList = Новый Структура;
	ФункцияList.Вставить("name", "list_files");
	ФункцияList.Вставить("description", "Получение списка файлов и подкаталогов в текущем рабочем каталоге.");
	ФункцияList.Вставить("parameters", ПараметрыList);
	
	ИнструментList = Новый Структура;
	ИнструментList.Вставить("type", "function");
	ИнструментList.Вставить("function", ФункцияList);
	Схемы.Добавить(ИнструментList);
	
	// 3. change_directory
	СвойствоPath = Новый Структура;
	СвойствоPath.Вставить("type", "string");
	СвойствоPath.Вставить("description", "Абсолютный путь (например, 'C:\\Temp' или '/var/log') или относительный путь от текущего каталога (например, '..' или 'subfolder').");
	
	СвойстваChange = Новый Структура;
	СвойстваChange.Вставить("path", СвойствоPath);
	
	ОбязательныеChange = Новый Массив;
	ОбязательныеChange.Добавить("path");
	
	ПараметрыChange = Новый Структура;
	ПараметрыChange.Вставить("type", "object");
	ПараметрыChange.Вставить("properties", СвойстваChange);
	ПараметрыChange.Вставить("required", ОбязательныеChange);
	
	ФункцияChange = Новый Структура;
	ФункцияChange.Вставить("name", "change_directory");
	ФункцияChange.Вставить("description", "Смена текущего рабочего каталога агента.");
	ФункцияChange.Вставить("parameters", ПараметрыChange);
	
	ИнструментChange = Новый Структура;
	ИнструментChange.Вставить("type", "function");
	ИнструментChange.Вставить("function", ФункцияChange);
	Схемы.Добавить(ИнструментChange);
	
	Возврат Схемы;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инструмент 1: get_os_info
Функция Инструмент_get_os_info()
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат СтрШаблон(
		"ОС: %1, Тип платформы: %2, Версия приложения: %3",
		СистемнаяИнформация.ВерсияОС,
		Строка(СистемнаяИнформация.ТипПлатформы),
		СистемнаяИнформация.ВерсияПриложения
	);
	
КонецФункции

// Инструмент 2: list_files
Функция Инструмент_list_files(Маска)
	
	Если ПустаяСтрока(Маска) Тогда
		Маска = "*.*";
	КонецЕсли;
	
	Попытка
		НайденныеФайлы = НайтиФайлы(ТекущийКаталог, Маска, Ложь);
	Исключение
		Возврат "Ошибка доступа к каталогу: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если НайденныеФайлы.Количество() = 0 Тогда
		Возврат "Каталог пуст.";
	КонецЕсли;
	
	СписокСтрок = Новый Массив;
	Для Каждого Файл Из НайденныеФайлы Цикл
		Если Файл.ЭтоКаталог() Тогда
			СписокСтрок.Добавить("[DIR] " + Файл.Имя);
		Иначе
			СписокСтрок.Добавить(СтрШаблон("[FILE] %1 (%2 байт)", Файл.Имя, Формат(Файл.Размер(), "ЧГ=0")));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(СписокСтрок, Символы.ПС);
	
КонецФункции

// Инструмент 3: change_directory
Функция Инструмент_change_directory(ПутьВхода)
	
	Разделитель = ПолучитьРазделительПути();
	
	Если ПустаяСтрока(ПутьВхода) Тогда
		Возврат "Ошибка: путь не указан.";
	КонецЕсли;
	
	ЦелевойПуть = СокрЛП(ПутьВхода);
	
	Если ЦелевойПуть = ".." Тогда
		КаталогБезСлэша = СокрЛП(ТекущийКаталог);
		Пока Прав(КаталогБезСлэша, 1) = "\" Или Прав(КаталогБезСлэша, 1) = "/" Цикл
			КаталогБезСлэша = Лев(КаталогБезСлэша, СтрДлина(КаталогБезСлэша) - 1);
		КонецЦикла;
		ФайлРодителя = Новый Файл(КаталогБезСлэша);
		ЦелевойПуть = ФайлРодителя.Путь;
	Иначе
		ПервыйСимвол = Лев(ЦелевойПуть, 1);
		ВторойСимвол = ?(СтрДлина(ЦелевойПуть) >= 2, Сред(ЦелевойПуть, 2, 1), "");
		ЭтоАбсолютный = (ПервыйСимвол = "/" Или ПервыйСимвол = "\" Или ВторойСимвол = ":");
		
		Если Не ЭтоАбсолютный Тогда
			БазовыйКаталог = ТекущийКаталог;
			Если Не (Прав(БазовыйКаталог, 1) = "\" Или Прав(БазовыйКаталог, 1) = "/") Тогда
				БазовыйКаталог = БазовыйКаталог + Разделитель;
			КонецЕсли;
			ЦелевойПуть = БазовыйКаталог + ЦелевойПуть;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Файл = Новый Файл(ЦелевойПуть);
		Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
			ТекущийКаталог = Файл.ПолноеИмя;
			Возврат "Текущий каталог успешно изменен на: " + ТекущийКаталог;
		Иначе
			Возврат "Ошибка: каталог не существует или путь ведет к файлу: " + ЦелевойПуть;
		КонецЕсли;
	Исключение
		Возврат "Ошибка при проверке каталога: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

// Разбор URL на составные части для создания HTTPСоединения
Функция РазобратьURL(Знач АдресURL) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Сервер", "");
	Результат.Вставить("Порт", 80);
	Результат.Вставить("ПутьРесурса", "/");
	Результат.Вставить("ЗащищенноеСоединение", Неопределено);
	
	АдресURL = СокрЛП(АдресURL);
	
	ЭтоHTTPS = (НРег(Лев(АдресURL, 8)) = "https://");
	ЭтоHTTP  = (НРег(Лев(АдресURL, 7)) = "http://");
	
	Если ЭтоHTTPS Тогда
		АдресURL = Сред(АдресURL, 9);
		Результат.Порт = 443;
		Результат.ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	ИначеЕсли ЭтоHTTP Тогда
		АдресURL = Сред(АдресURL, 8);
		Результат.Порт = 80;
	КонецЕсли;
	
	ПозицияСлэша = СтрНайти(АдресURL, "/");
	Если ПозицияСлэша > 0 Тогда
		ХостИПорт = Лев(АдресURL, ПозицияСлэша - 1);
		Результат.ПутьРесурса = Сред(АдресURL, ПозицияСлэша);
	Иначе
		ХостИПорт = АдресURL;
		Результат.ПутьРесурса = "/";
	КонецЕсли;
	
	ПозицияДвоеточия = СтрНайти(ХостИПорт, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Сервер = Лев(ХостИПорт, ПозицияДвоеточия - 1);
		ПортСтрока = Сред(ХостИПорт, ПозицияДвоеточия + 1);
		Попытка
			Результат.Порт = Число(ПортСтрока);
		Исключение
		КонецПопытки;
	Иначе
		Результат.Сервер = ХостИПорт;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Безопасный разбор JSON-строки в Структуру
Функция РазобратьJSONСтроку(Знач СтрокаJSON)
	
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		Попытка
			ЧтениеJSON.Закрыть();
		Исключение
		КонецПопытки;
		Возврат Новый Структура;
	КонецПопытки;
	
КонецФункции

// Добавление строки в лог рассуждений агента
Процедура ДобавитьВЛог(ТекстСообщения)
	
	Если ПустаяСтрока(ЛогРассуждений) Тогда
		ЛогРассуждений = ТекстСообщения;
	Иначе
		ЛогРассуждений = ЛогРассуждений + Символы.ПС + ТекстСообщения;
	КонецЕсли;
	
КонецПроцедуры

// Вспомогательная функция для обрезки концевых переводов строк
Функция СокращатьТекст(Знач Текст)
	Возврат СокрЛП(Текст);
КонецФункции

#КонецОбласти
