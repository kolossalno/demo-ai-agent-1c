	|      <span class=""jk"">""type""</span>: <span class=""jt"">""object""</span>,
	|      <span class=""jk"">""properties""</span>: {
	|        <span class=""jk"">""path""</span>: {
	|          <span class=""jk"">""type""</span>: <span class=""jt"">""string""</span>,
	|          <span class=""jk"">""description""</span>: <span class=""jd"">""Абсолютный или относительный путь ('..', 'папка')""</span>
	|        }
	|      },
	|      <span class=""jk"">""required""</span>: [<span class=""js"">""path""</span>]
	|    }
	|  }
	|}</pre>
	|</div>
	|</body>
	|</html>";
	
	РезультатHTML = ШаблонHTML;
	РезультатHTML = СтрЗаменить(РезультатHTML, "[КЛАСС_1]", Класс1);
	РезультатHTML = СтрЗаменить(РезультатHTML, "[КЛАСС_2]", Класс2);
	РезультатHTML = СтрЗаменить(РезультатHTML, "[КЛАСС_3]", Класс3);
	РезультатHTML = СтрЗаменить(РезультатHTML, "[СТАТУС_ЗАГОЛОВКА]", СтатусЗаголовка);
	РезультатHTML = СтрЗаменить(РезультатHTML, "[БЕЙДЖ_1]", Бейдж1);
	РезультатHTML = СтрЗаменить(РезультатHTML, "[БЕЙДЖ_2]", Бейдж2);
	РезультатHTML = СтрЗаменить(РезультатHTML, "[БЕЙДЖ_3]", Бейдж3);
	
	Возврат РезультатHTML;
	
КонецФункции

// Разбор URL на составные части для создания HTTPСоединения
Функция РазобратьURL(Знач АдресURL) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Сервер", "");
	Результат.Вставить("Порт", 80);
	Результат.Вставить("ПутьРесурса", "/");
	Результат.Вставить("ЗащищенноеСоединение", Неопределено);
	
	АдресURL = СокрЛП(АдресURL);
	
	ЭтоHTTPS = (НРег(Лев(АдресURL, 8)) = "https://");
	ЭтоHTTP  = (НРег(Лев(АдресURL, 7)) = "http://");
	
	Если ЭтоHTTPS Тогда
		АдресURL = Сред(АдресURL, 9);
		Результат.Порт = 443;
		Результат.ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	ИначеЕсли ЭтоHTTP Тогда
		АдресURL = Сред(АдресURL, 8);
		Результат.Порт = 80;
	КонецЕсли;
	
	ПозицияСлэша = СтрНайти(АдресURL, "/");
	Если ПозицияСлэша > 0 Тогда
		ХостИПорт = Лев(АдресURL, ПозицияСлэша - 1);
		Результат.ПутьРесурса = Сред(АдресURL, ПозицияСлэша);
	Иначе
		ХостИПорт = АдресURL;
		Результат.ПутьРесурса = "/";
	КонецЕсли;
	
	ПозицияДвоеточия = СтрНайти(ХостИПорт, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Сервер = Лев(ХостИПорт, ПозицияДвоеточия - 1);
		ПортСтрока = Сред(ХостИПорт, ПозицияДвоеточия + 1);
		Попытка
			Результат.Порт = Число(ПортСтрока);
		Исключение
		КонецПопытки;
	Иначе
		Результат.Сервер = ХостИПорт;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Безопасный разбор JSON-строки в Структуру
Функция РазобратьJSONСтроку(Знач СтрокаJSON) Экспорт
	
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		Попытка
			ЧтениеJSON.Закрыть();
		Исключение
		КонецПопытки;
		Возврат Новый Структура;
	КонецПопытки;
	
КонецФункции

