// Инструмент 1: get_os_info
Функция Инструмент_get_os_info()
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат СтрШаблон(
		"ОС: %1, Тип платформы: %2, Версия приложения: %3",
		СистемнаяИнформация.ВерсияОС,
		Строка(СистемнаяИнформация.ТипПлатформы),
		СистемнаяИнформация.ВерсияПриложения
	);
	
КонецФункции

// Инструмент 2: list_files
Функция Инструмент_list_files(Маска)
	
	Если ПустаяСтрока(Маска) Тогда
		Маска = "*.*";
	КонецЕсли;
	
	Попытка
		НайденныеФайлы = НайтиФайлы(ТекущийКаталог, Маска, Ложь);
	Исключение
		Возврат "Ошибка доступа к каталогу: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если НайденныеФайлы.Количество() = 0 Тогда
		Возврат "Каталог пуст.";
	КонецЕсли;
	
	СписокСтрок = Новый Массив;
	Для Каждого Файл Из НайденныеФайлы Цикл
		Если Файл.ЭтоКаталог() Тогда
			СписокСтрок.Добавить("[DIR] " + Файл.Имя);
		Иначе
			СписокСтрок.Добавить(СтрШаблон("[FILE] %1 (%2 байт)", Файл.Имя, Формат(Файл.Размер(), "ЧГ=0")));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(СписокСтрок, Символы.ПС);
	
КонецФункции

// Инструмент 3: change_directory
Функция Инструмент_change_directory(ПутьВхода)
	
	Разделитель = ПолучитьРазделительПути();
	
	Если ПустаяСтрока(ПутьВхода) Тогда
		Возврат "Ошибка: путь не указан.";
	КонецЕсли;
	
	ЦелевойПуть = СокрЛП(ПутьВхода);
	
	Если ЦелевойПуть = ".." Тогда
		КаталогБезСлэша = СокрЛП(ТекущийКаталог);
		Пока Прав(КаталогБезСлэша, 1) = "\" Или Прав(КаталогБезСлэша, 1) = "/" Цикл
			КаталогБезСлэша = Лев(КаталогБезСлэша, СтрДлина(КаталогБезСлэша) - 1);
		КонецЦикла;
		ФайлРодителя = Новый Файл(КаталогБезСлэша);
		ЦелевойПуть = ФайлРодителя.Путь;
	Иначе
		ПервыйСимвол = Лев(ЦелевойПуть, 1);
		ВторойСимвол = ?(СтрДлина(ЦелевойПуть) >= 2, Сред(ЦелевойПуть, 2, 1), "");
		ЭтоАбсолютный = (ПервыйСимвол = "/" Или ПервыйСимвол = "\" Или ВторойСимвол = ":");
		
		Если Не ЭтоАбсолютный Тогда
			БазовыйКаталог = ТекущийКаталог;
			Если Не (Прав(БазовыйКаталог, 1) = "\" Или Прав(БазовыйКаталог, 1) = "/") Тогда
				БазовыйКаталог = БазовыйКаталог + Разделитель;
			КонецЕсли;
			ЦелевойПуть = БазовыйКаталог + ЦелевойПуть;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Файл = Новый Файл(ЦелевойПуть);
		Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
			ТекущийКаталог = Файл.ПолноеИмя;
			Возврат "Текущий каталог успешно изменен на: " + ТекущийКаталог;
		Иначе
			Возврат "Ошибка: каталог не существует или путь ведет к файлу: " + ЦелевойПуть;
		КонецЕсли;
	Исключение
		Возврат "Ошибка при проверке каталога: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

// Добавление строки в лог рассуждений агента
Процедура ДобавитьВЛог(ТекстСообщения)
	
	Если ПустаяСтрока(ЛогРассуждений) Тогда
		ЛогРассуждений = ТекстСообщения;
	Иначе
		ЛогРассуждений = ЛогРассуждений + Символы.ПС + ТекстСообщения;
	КонецЕсли;
	
КонецПроцедуры

// Вспомогательная функция для обрезки концевых переводов строк
Функция СокращатьТекст(Знач Текст)
	Возврат СокрЛП(Текст);
КонецФункции

