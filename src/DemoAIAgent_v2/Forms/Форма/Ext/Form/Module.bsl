#Область ОписаниеПеременных

&НаКлиенте
Перем КонтекстАгента;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Инициализация значений по умолчанию
	Если ПустаяСтрока(Объект.АдресAPI) Тогда
		Объект.АдресAPI = "http://localhost:11434/v1/chat/completions";
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.APIКлюч) Тогда
		Объект.APIКлюч = "ollama";
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.Модель) Тогда
		Объект.Модель = "qwen2.5-coder:7b";
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.ТекущийКаталог) Тогда
		Объект.ТекущийКаталог = КаталогВременныхФайлов();
	КонецЕсли;
	
	Если Объект.МаксимумИтераций = 0 Тогда
		Объект.МаксимумИтераций = 10;
	КонецЕсли;
	
	// Начальная отрисовка HTML с перечнем инструментов MCP
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ИнструментыHTML = ОбработкаОбъект.СформироватьHTMLИнструментов("");
	
	Элементы.КнопкаОстановить.Доступность = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьЗапрос(Команда)
	
	Если ПустаяСтрока(Объект.ЗапросПользователя) Тогда
		ПоказатьПредупреждение(, "Укажите запрос для автономного ИИ-агента!");
		Возврат;
	КонецЕсли;
	
	Элементы.КнопкаВыполнитьЗапрос.Доступность = Ложь;
	Элементы.КнопкаОстановить.Доступность = Истина;
	
	Объект.ФинальныйОтвет = "";
	Объект.ЛогРассуждений = "";
	
	// Инициализация рабочего контекста
	ДанныеИнициализации = ИнициализироватьАгентаНаСервере();
	
	КонтекстАгента = Новый Структура;
	КонтекстАгента.Вставить("Итерация", 1);
	КонтекстАгента.Вставить("Сообщения", ДанныеИнициализации.Сообщения);
	КонтекстАгента.Вставить("Остановлен", Ложь);
	КонтекстАгента.Вставить("ОчередьВызовов", Новый Массив);
	КонтекстАгента.Вставить("ТекущийВызов", Неопределено);
	
	ВыполнитьСледующийШаг();
	
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьАгента(Команда)
	
	Если КонтекстАгента <> Неопределено Тогда
		КонтекстАгента.Остановлен = Истина;
	КонецЕсли;
	
	ЗавершитьРаботуАгента("Работа агента прервана пользователем.");
	
КонецПроцедуры

#КонецОбласти

#Область ПошаговыйЦиклАгента

&НаКлиенте
Процедура ВыполнитьСледующийШаг()
	
	Если КонтекстАгента = Неопределено Или КонтекстАгента.Остановлен Тогда
		Возврат;
	КонецЕсли;
	
	// 1. Если в очереди есть вызовы инструментов — выполняем следующий по очереди
	Если КонтекстАгента.ОчередьВызовов.Количество() > 0 Тогда
		
		ТекущийВызов = КонтекстАгента.ОчередьВызовов[0];
		КонтекстАгента.ОчередьВызовов.Удалить(0);
		КонтекстАгента.ТекущийВызов = ТекущийВызов;
		
		// Подсвечиваем инструмент с анимацией в HTML
		УстановитьАктивныйИнструментНаСервере(ТекущийВызов.ИмяФункции);
		ДобавитьВЛогНаКлиенте(СтрШаблон("[ВЫЗОВ] %1(%2)", ТекущийВызов.ИмяФункции, ТекущийВызов.АргументыСтрокой));
		
		// Пауза 0.4 сек для наглядного отображения анимации в интерфейсе
		ПодключитьОбработчикОжидания("ОбработчикВыполненияИнструмента", 0.4, Истина);
		Возврат;
		
	КонецЕсли;
	
	// 2. Проверка лимита итераций
	Если КонтекстАгента.Итерация > Объект.МаксимумИтераций Тогда
		ЗавершитьРаботуАгента("Достигнут лимит итераций. Агент не успел завершить задачу.");
		Возврат;
	КонецЕсли;
	
	ДобавитьВЛогНаКлиенте(СтрШаблон("--- Итерация %1 ---", Формат(КонтекстАгента.Итерация, "ЧГ=0")));
	
	// 3. Отправка запроса к LLM
	ОтветLLM = ВыполнитьЗапросКLLMНаСервере(КонтекстАгента.Сообщения);
	
	Если ОтветLLM.Ошибка Тогда
		ЗавершитьРаботуАгента(ОтветLLM.ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	КонтекстАгента.Сообщения = ОтветLLM.Сообщения;
	
	Если ОтветLLM.Завершено Тогда
		Объект.ФинальныйОтвет = ОтветLLM.ФинальныйОтвет;
		ДобавитьВЛогНаКлиенте("[ФИНАЛ] Агент завершил работу.");
		УстановитьАктивныйИнструментНаСервере("");
		ЗавершитьРаботуАгента();
		Возврат;
	КонецЕсли;
	
	// 4. Заполнение очереди вызовов инструментов
	КонтекстАгента.ОчередьВызовов = ОтветLLM.Вызовы;
	КонтекстАгента.Итерация = КонтекстАгента.Итерация + 1;
	
	// Переход к исполнению вызовов
	ВыполнитьСледующийШаг();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыполненияИнструмента()
	
	Если КонтекстАгента = Неопределено Или КонтекстАгента.Остановлен Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийВызов = КонтекстАгента.ТекущийВызов;
	
	// Серверное выполнение инструмента в 1С
	Результат = ВыполнитьИнструментНаСервере(ТекущийВызов.ИмяФункции, ТекущийВызов.АргументыСтрокой, ТекущийВызов.IDВызова);
	
	ДобавитьВЛогНаКлиенте("[ОТВЕТ 1С] " + Результат.РезультатСтрокой);
	КонтекстАгента.Сообщения.Добавить(Результат.СообщениеОтвета);
	
	// Сброс подсветки активности инструмента
	УстановитьАктивныйИнструментНаСервере("");
	
	// Пауза 0.2 сек перед следующим шагом
	ПодключитьОбработчикОжидания("ВыполнитьСледующийШаг", 0.2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРаботуАгента(Знач ТекстСообщения = "")
	
	Элементы.КнопкаВыполнитьЗапрос.Доступность = Истина;
	Элементы.КнопкаОстановить.Доступность = Ложь;
	
	Если Не ПустаяСтрока(ТекстСообщения) И ПустаяСтрока(Объект.ФинальныйОтвет) Тогда
		Объект.ФинальныйОтвет = ТекстСообщения;
		ДобавитьВЛогНаКлиенте("[ОСТАНОВ] " + ТекстСообщения);
	КонецЕсли;
	
	УстановитьАктивныйИнструментНаСервере("");
	КонтекстАгента = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВЛогНаКлиенте(ТекстСообщения)
	
	Если ПустаяСтрока(Объект.ЛогРассуждений) Тогда
		Объект.ЛогРассуждений = ТекстСообщения;
	Иначе
		Объект.ЛогРассуждений = Объект.ЛогРассуждений + Символы.ПС + ТекстСообщения;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеМетоды

&НаСервере
Функция ИнициализироватьАгентаНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	СистемныйПромпт = СтрШаблон(
		"Ты — автономный ИИ-агент, работающий внутри платформы 1С:Предприятие. Твой стартовый рабочий каталог: %1. "
		+ "Для исследования файловой системы и получения информации о среде используй доступные инструменты. "
		+ "Отвечай на русском языке четко и по делу после того, как соберешь все необходимые данные.",
		Объект.ТекущийКаталог
	);
	
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "system", СистемныйПромпт));
	Сообщения.Добавить(Новый Структура("role, content", "user", Объект.ЗапросПользователя));
	
	ИнструментыHTML = ОбработкаОбъект.СформироватьHTMLИнструментов("");
	
	Возврат Новый Структура("Сообщения", Сообщения);
	
КонецФункции

&НаСервере
Процедура УстановитьАктивныйИнструментНаСервере(Знач ИмяИнструмента)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ИнструментыHTML = ОбработкаОбъект.СформироватьHTMLИнструментов(ИмяИнструмента);
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапросКLLMНаСервере(Знач Сообщения)
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Завершено", Ложь);
	Результат.Вставить("ФинальныйОтвет", "");
	Результат.Вставить("Вызовы", Новый Массив);
	Результат.Вставить("Сообщения", Сообщения);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПараметрыURL = ОбработкаОбъект.РазобратьURL(Объект.АдресAPI);
	Если ПустаяСтрока(ПараметрыURL.Сервер) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не указан адрес API или не удалось определить сервер из адреса: " + Объект.АдресAPI;
		Возврат Результат;
	КонецЕсли;
	СхемыИнструментов = ОбработкаОбъект.ПолучитьСхемыИнструментов();
	
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("model", Объект.Модель);
	ТелоЗапроса.Вставить("messages", Сообщения);
	ТелоЗапроса.Вставить("tools", СхемыИнструментов);
	ТелоЗапроса.Вставить("temperature", 0.1);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Попытка
		Соединение = Новый HTTPСоединение(
			ПараметрыURL.Сервер,
			ПараметрыURL.Порт,
			, , , 60,
			ПараметрыURL.ЗащищенноеСоединение
		);
		
		HTTPЗапрос = Новый HTTPЗапрос(ПараметрыURL.ПутьРесурса);
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Если Не ПустаяСтрока(Объект.APIКлюч) Тогда
			HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Объект.APIКлюч);
		КонецЕсли;
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Ошибка сетевого соединения с LLM: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Если HTTPОтвет.КодСостояния <> 200 Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = СтрШаблон("Сервер LLM вернул код %1: %2", HTTPОтвет.КодСостояния, HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Возврат Результат;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	ОтветСтруктура = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	
	СообщениеОтвета = ОтветСтруктура.choices[0].message;
	Сообщения.Добавить(СообщениеОтвета);
	Результат.Сообщения = Сообщения;
	
	ЕстьВызовы = СообщениеОтвета.Свойство("tool_calls")
		И СообщениеОтвета.tool_calls <> Неопределено
		И ТипЗнч(СообщениеОтвета.tool_calls) = Тип("Массив")
		И СообщениеОтвета.tool_calls.Количество() > 0;
	
	Если Не ЕстьВызовы Тогда
		Результат.Завершено = Истина;
		Если СообщениеОтвета.Свойство("content") И СообщениеОтвета.content <> Неопределено Тогда
			Результат.ФинальныйОтвет = СокрЛП(Строка(СообщениеОтвета.content));
		КонецЕсли;
	Иначе
		Для Каждого Вызов Из СообщениеОтвета.tool_calls Цикл
			ИнфоВызова = Новый Структура;
			ИнфоВызова.Вставить("IDВызова", Вызов.id);
			ИнфоВызова.Вставить("ИмяФункции", Вызов.function.name);
			ИнфоВызова.Вставить("АргументыСтрокой", Вызов.function.arguments);
			Результат.Вызовы.Добавить(ИнфоВызова);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ВыполнитьИнструментНаСервере(Знач ИмяФункции, Знач АргументыСтрокой, Знач IDВызова)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатСтрокой = ОбработкаОбъект.ВыполнитьИнструмент(ИмяФункции, АргументыСтрокой);
	
	// Синхронизируем текущий каталог, если инструмент изменил его
	Объект.ТекущийКаталог = ОбработкаОбъект.ТекущийКаталог;
	
	СообщениеОтвета = Новый Структура;
	СообщениеОтвета.Вставить("role", "tool");
	СообщениеОтвета.Вставить("tool_call_id", IDВызова);
	СообщениеОтвета.Вставить("content", РезультатСтрокой);
	
	Возврат Новый Структура("РезультатСтрокой, СообщениеОтвета", РезультатСтрокой, СообщениеОтвета);
	
КонецФункции

#КонецОбласти
