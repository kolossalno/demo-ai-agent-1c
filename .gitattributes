# Auto detect text files and perform LF normalization
* text=auto

# 1C modules and metadata XML - always CRLF
*.bsl text eol=crlf
*.xml text eol=crlf
*.json text eol=crlf
*.ps1 text eol=crlf
*.txt text eol=crlf

# Markdown and YAML - LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 1C binary deliverables
*.epf binary
*.erf binary
*.cf binary
*.cfe binary
*.dt binary

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
